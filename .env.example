# ===== AI 模型 API Keys =====
OPENAI_API_KEY=your_key_here
DEEPSEEK_API_KEY=your_key_here
QWEN_API_KEY=your_key_here

# ===== 微信公众号抓取（纯远程 MP API 方案）=====
# 从 mp.weixin.qq.com 后台 F12 获取的 Cookie（会过期，过期时脚本会邮件提醒）
WEREAD_COOKIE=your_mp_cookie_here
# 从 mp.weixin.qq.com 后台 F12 获取的 token
MP_QUERY_TOKEN=your_mp_token_here
# 每个公众号之间的抓取延迟秒数（微信 appmsg 频控严格，长延迟降低触发风险，默认 6）
MP_DELAY_SECONDS=6

# ===== 邮件告警（Cookie 过期等异常通知）=====
# QQ 邮箱示例：SMTP_HOST=smtp.qq.com, SMTP_PORT=465, SMTP_TLS=true
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_TLS=true
SMTP_USER=your_smtp_user@qq.com
SMTP_PASSWORD=your_smtp_authorization_code
SMTP_FROM=your_smtp_user@qq.com
# 接收告警的邮箱（多个用 ; 分隔）
NOTIFY_TO=your_email@example.com
