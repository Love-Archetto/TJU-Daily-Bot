# ===== AI 模型 API Keys =====
OPENAI_API_KEY=your_key_here
DEEPSEEK_API_KEY=your_key_here
QWEN_API_KEY=your_key_here
# TJU 开源大模型平台（OpenAI 兼容协议，模型名为 tju-llm）
TJU_API_KEY=your_tju_api_key_here

# ===== 微信公众号抓取（we-mp-rss 在 GitHub Actions 中采集）=====
# 微信读书（weread.qq.com）Cookie，用于 we-mp-rss 采集公众号。
# 登录 weread.qq.com → F12 → 复制 Cookie（含 wr_vid / wr_skey / wr_rt 等）。
# 仅存于 GitHub Actions Secret（WEREAD_COOKIE），本地不需要。
WEREAD_COOKIE=your_weread_cookie_here
# we-mp-rss 服务地址（Actions 里由 service 提供 localhost:8001）
WE_MP_RSS_BASE=http://localhost:8001

# ===== 邮件告警（Cookie 过期等异常通知）=====
# QQ 邮箱示例：SMTP_HOST=smtp.qq.com, SMTP_PORT=465, SMTP_TLS=true
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_TLS=true
SMTP_USER=your_smtp_user@qq.com
SMTP_PASSWORD=your_smtp_authorization_code
SMTP_FROM=your_smtp_user@qq.com
# 接收告警的邮箱（多个用 ; 分隔）
NOTIFY_TO=your_email@example.com
