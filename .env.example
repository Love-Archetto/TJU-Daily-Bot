# ===== AI 模型 API Keys =====
OPENAI_API_KEY=your_key_here
DEEPSEEK_API_KEY=your_key_here
QWEN_API_KEY=your_key_here
# TJU 开源大模型平台（OpenAI 兼容协议，模型名为 tju-llm）
TJU_API_KEY=your_tju_api_key_here

# ===== 微信公众号抓取（本地：复用真实 Edge CDP；CI 已不依赖公众号）=====
# 本地公众号抓取改为「复用真实 Edge 会话」，用 playwright connect_over_cdp 连到带调试端口、
# 已登录微信读书的 Edge（详见 weread_cdp.py）。首次用 tools/start_weread_edge.py 拉 Edge 并扫码。
# 登录态在 Edge 会话里，不再需要 WEREAD_COOKIE（保留仅兼容旧脚本）。
WEREAD_EDGE_PORT=9333
# Edge 固定 user-data-dir（仓库外，登录态持久化）。不设则默认 %LOCALAPPDATA%\TJUNews\weread_edge_profile
#WEREAD_EDGE_PROFILE=C:\Users\you\AppData\Local\TJUNews\weread_edge_profile
# （旧方案，仅 CI 遗留参考）微信读书 Cookie，用于 we-mp-rss 采集公众号。
#WEREAD_COOKIE=your_weread_cookie_here
# 旧 we-mp-rss 服务地址（Actions 里由 service 提供 localhost:8001）
#WE_MP_RSS_BASE=http://localhost:8001

# ===== 邮件告警（Cookie 过期等异常通知）=====
# QQ 邮箱示例：SMTP_HOST=smtp.qq.com, SMTP_PORT=465, SMTP_TLS=true
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_TLS=true
SMTP_USER=your_smtp_user@qq.com
SMTP_PASSWORD=your_smtp_authorization_code
SMTP_FROM=your_smtp_user@qq.com
# 接收告警的邮箱（多个用 ; 分隔）
NOTIFY_TO=your_email@example.com
